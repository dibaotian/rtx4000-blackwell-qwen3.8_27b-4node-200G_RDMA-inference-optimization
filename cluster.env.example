# Copy this file to cluster.env on every node and keep the values identical.
# NODE_IP is normally detected from RAY_INTERFACE and may be overridden per node.

VLLM_IMAGE=vllm-blackwell-ray:20260828
VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:38cf880a732998a3664174a7d07be38026aeb9a9b8cddfa96cadd5f8613f92fb
CONTAINER_NAME=vllm-ray-node
CLUSTER_NODES=<NODE0_IP>,<NODE1_IP>,<NODE2_IP>,<NODE3_IP>
REMOTE_ROOT=/data/vllm

# Ray uses the first private ARNIC rail for control traffic. "auto" resolves
# arnic_0 to its local netdev (ens7 on nodes 1/2, ens8 on nodes 3/4).
HEAD_IP=<NODE0_IP>
RAY_INTERFACE=auto
RAY_PORT=6379

# "auto" resolves all active RDMA netdevs on each node.
NCCL_SOCKET_IFNAME=auto
NCCL_IB_HCA=arnic_0,arnic_1
NCCL_IB_GID_INDEX=1
NCCL_CROSS_NIC=1
NCCL_DEBUG=INFO

# ARNIC uses a custom libibverbs provider built at this absolute path. The
# directory must exist at the same path on every node.
ARNIC_RDMA_ROOT=<ARNIC_RDMA_ROOT>

# These directories must exist locally at the same path on every node.
HF_CACHE_HOST=/data/vllm/hf-cache
VLLM_CACHE_HOST=/data/vllm/vllm-cache
LOG_DIR_HOST=/data/vllm/logs/cluster
MODEL_ROOT_HOST=/data/vllm/models

# The official FP8 checkpoint leaves substantially more KV-cache headroom.
MODEL_SOURCE=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
MODEL_ID=/models/Qwen_Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b
API_HOST=0.0.0.0
API_PORT=8000
# Native model maximum. Requests near this length should be limited to
# concurrency 1; benchmarked concurrency 2+ causes preemption and minute-scale latency.
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
# Validated service profile for application concurrency 1 through 4.
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=4
# Optional comma-separated hidden-layer counts for PP stages. The values must
# contain one entry per PP stage and sum to the model's hidden-layer count.
VLLM_PP_LAYER_PARTITION=''

# CUDA graphs improve measured decode throughput. Capture only the active
# concurrency range; automatic sizes are 1, 2, and 4. Set true only for debugging.
ENFORCE_EAGER=false
CUDAGRAPH_CAPTURE_SIZES=
MAX_CUDAGRAPH_CAPTURE_SIZE=4
# Set LANGUAGE_MODEL_ONLY=false for image/video input.
LANGUAGE_MODEL_ONLY=true
ENABLE_PREFIX_CACHING=true
# Empty disables speculative decoding. MTP and DFlash2 do not currently support
# this model with PIPELINE_PARALLEL_SIZE=4; do not enable either method here.
SPECULATIVE_CONFIG=''

# Optional OpenAI-compatible API authentication. Keep empty only on a trusted
# network; cluster.env should be readable by its owner only when this is set.
API_KEY=

# ARNIC access is most reliable in a privileged container. Set this to false
# only after validating that explicit /dev/infiniband device access works.
DOCKER_PRIVILEGED=true